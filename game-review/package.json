    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/subgraph": "^2.14.3",
    "@as-integrations/aws-lambda": "^4.1.0",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7"
  }
}
