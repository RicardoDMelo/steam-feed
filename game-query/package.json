{
  "name": "game-query",
  "version": "1.0.0",
  "license": "ISC",
  "author": "ricardo.d.melo@hotmail.com",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts src/schema.graphql --bundle --platform=node --format=cjs --target=node24 --outdir=dist --outbase=src --loader:.graphql=copy",
    "start": "node ./dist/index.js",
    "dev": "tsx watch --env-file=.env --inspect src/local-server.ts",
    "supergraph": "rover supergraph compose --config ./supergraph.yaml --output src/schema.graphql"
  },
  "devDependencies": {
    "@apollo/rover": "^0.41.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "esbuild": "0.28.1",
    "express": "^5.2.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@apollo/gateway": "^2.14.3",
    "@apollo/server": "^5.5.1",
    "@as-integrations/aws-lambda": "^4.1.0",
    "@aws-sdk/client-sns": "^3.1095.0",
    "@aws-sdk/lib-dynamodb": "^3.1090.0",
    "graphql": "^16.14.2"
  }
}
